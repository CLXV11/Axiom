{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public user directory profile, handle, profession, and presence settings (no PII)",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "handle": { "type": "string" },
        "bio": { "type": "string" },
        "profession": { "type": "string" },
        "isProfessionalVerified": { "type": "boolean" },
        "professionalOrg": { "type": "string" },
        "openToNetworking": { "type": "boolean" },
        "avatarUrl": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "verifiedTier": { "type": "string", "enum": ["BLUE", "GOLD", "EMERALD", "ROSE_GOLD", "AMETHYST", "ONYX", "PLATINUM"] },
        "equippedFrame": { "type": "string" },
        "equippedNameplate": { "type": "string" },
        "quietMode": { "type": "boolean" },
        "readReceiptsEnabled": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "handle", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct or group chat conversation metadata and participant list",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["direct", "group"] },
        "title": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "verifiedTier": { "type": "string", "enum": ["BLUE", "GOLD", "EMERALD", "ROSE_GOLD", "AMETHYST", "ONYX", "PLATINUM"] },
        "participantIds": { "type": "array" },
        "lastMessageText": { "type": "string" },
        "lastMessageSenderId": { "type": "string" },
        "lastMessageTimestamp": { "type": "string", "format": "date-time" },
        "pinnedBy": { "type": "array" },
        "archivedBy": { "type": "array" },
        "mutedBy": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "participantIds", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual message within a conversation",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "isSenderVerified": { "type": "boolean" },
        "senderVerifiedTier": { "type": "string" },
        "content": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["text", "image", "video", "file"] },
        "mediaId": { "type": "string" },
        "mediaFileName": { "type": "string" },
        "mediaMimeType": { "type": "string" },
        "mediaSizeBytes": { "type": "integer" },
        "mediaChunkCount": { "type": "integer" },
        "mediaDurationMs": { "type": "integer" },
        "replyToId": { "type": "string" },
        "replyToSender": { "type": "string" },
        "replyToText": { "type": "string" },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"] },
        "readBy": { "type": "array" },
        "isEdited": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "reactions": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["conversationId", "senderId", "senderName", "content", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Social feed post with audience control and contextual threads",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorHandle": { "type": "string" },
        "isAuthorVerified": { "type": "boolean" },
        "authorVerifiedTier": { "type": "string" },
        "content": { "type": "string" },
        "audience": { "type": "string", "enum": ["public", "circles"] },
        "likedBy": { "type": "array" },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "reactions": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "authorHandle", "content", "audience", "createdAt"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Comment or context thread attached to a post",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorHandle": { "type": "string" },
        "isAuthorVerified": { "type": "boolean" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "authorId", "authorName", "content", "createdAt"]
    },
    "SavedMemory": {
      "title": "SavedMemory",
      "description": "Private bookmarked message with personal notes",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "originalMessageId": { "type": "string" },
        "conversationId": { "type": "string" },
        "snippet": { "type": "string" },
        "senderName": { "type": "string" },
        "privateNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "originalMessageId", "snippet", "createdAt"]
    },
    "FluxVideo": {
      "title": "FluxVideo",
      "description": "Short video or creative gradient clip shared on Flux",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorHandle": { "type": "string" },
        "isAuthorVerified": { "type": "boolean" },
        "authorVerifiedTier": { "type": "string" },
        "caption": { "type": "string" },
        "videoUri": { "type": "string" },
        "mediaId": { "type": "string" },
        "mediaMimeType": { "type": "string" },
        "mediaSizeBytes": { "type": "integer" },
        "mediaChunkCount": { "type": "integer" },
        "audioTitle": { "type": "string" },
        "likesCount": { "type": "integer" },
        "likedBy": { "type": "array" },
        "commentsCount": { "type": "integer" },
        "sharesCount": { "type": "integer" },
        "savedBy": { "type": "array" },
        "tags": { "type": "array" },
        "gradientTheme": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "authorHandle", "caption", "createdAt"]
    },
    "FluxComment": {
      "title": "FluxComment",
      "description": "Comment on a Flux short video clip",
      "type": "object",
      "properties": {
        "fluxId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorHandle": { "type": "string" },
        "isAuthorVerified": { "type": "boolean" },
        "authorVerifiedTier": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fluxId", "authorId", "authorName", "content", "createdAt"]
    },
    "StoreWallet": {
      "title": "StoreWallet",
      "description": "Server-validated user economy wallet, owned decorations, milestones, and daily reward cooldown",
      "type": "object",
      "properties": {
        "coinBalance": { "type": "integer" },
        "ownedItemIds": { "type": "array" },
        "claimedMilestones": { "type": "array" },
        "lastDailyClaimAt": { "type": "string", "format": "date-time" },
        "equippedFrame": { "type": "string" },
        "equippedNameplate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["coinBalance", "ownedItemIds", "claimedMilestones", "createdAt", "updatedAt"]
    },
    "MediaChunk": {
      "title": "MediaChunk",
      "description": "Chunked high-quality media payload belonging to a conversation",
      "type": "object",
      "properties": {
        "mediaId": { "type": "string" },
        "senderId": { "type": "string" },
        "index": { "type": "integer" },
        "data": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["mediaId", "senderId", "index", "data", "createdAt"]
    },
    "VoiceCall": {
      "title": "VoiceCall",
      "description": "Two-party WebRTC voice call signaling session",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" },
        "callerId": { "type": "string" },
        "callerName": { "type": "string" },
        "callerAvatarUrl": { "type": "string" },
        "calleeId": { "type": "string" },
        "calleeName": { "type": "string" },
        "calleeAvatarUrl": { "type": "string" },
        "participantIds": { "type": "array" },
        "status": { "type": "string", "enum": ["ringing", "connecting", "connected", "ended", "declined", "missed"] },
        "offerSdp": { "type": "string" },
        "answerSdp": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["conversationId", "callerId", "callerName", "calleeId", "participantIds", "status", "createdAt", "updatedAt"]
    },
    "CallCandidate": {
      "title": "CallCandidate",
      "description": "ICE candidate for an active WebRTC voice call",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "sdpMid": { "type": "string" },
        "sdpMLineIndex": { "type": "integer" },
        "candidate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "sdpMid", "sdpMLineIndex", "candidate", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User directory profiles and presence status"
    },
    "/users/{userId}/wallet/{walletId}": {
      "schema": "StoreWallet",
      "description": "Server-authoritative coin wallet and owned store decorations"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Direct and group chat conversations"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages inside conversation"
    },
    "/conversations/{conversationId}/media/{mediaId}/chunks/{chunkId}": {
      "schema": "MediaChunk",
      "description": "Binary media chunks for high-quality photos, videos, and files"
    },
    "/calls/{callId}": {
      "schema": "VoiceCall",
      "description": "Active and recent 2-party voice call sessions"
    },
    "/calls/{callId}/candidates/{candidateId}": {
      "schema": "CallCandidate",
      "description": "WebRTC ICE signaling candidates"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Feed posts"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "PostComment",
      "description": "Comments and context threads for posts"
    },
    "/users/{userId}/saved_memories/{memoryId}": {
      "schema": "SavedMemory",
      "description": "User personal saved messages with private notes"
    },
    "/flux_videos/{fluxId}": {
      "schema": "FluxVideo",
      "description": "Short video clips shared in Flux feed"
    },
    "/flux_videos/{fluxId}/comments/{commentId}": {
      "schema": "FluxComment",
      "description": "Comments on Flux video clips"
    },
    "/flux_media/{mediaId}/chunks/{chunkId}": {
      "schema": "MediaChunk",
      "description": "Binary video chunks for cross-user Flux playback"
    }
  }
}
