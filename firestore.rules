rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTier(tier) {
      return tier in ['BLUE', 'GOLD', 'EMERALD', 'ROSE_GOLD', 'AMETHYST', 'ONYX', 'PLATINUM'];
    }

    function isValidStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is string);
    }

    function isConvoParticipant(conversationId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
             request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }

    function isValidUserProfile(data) {
      return data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 40 &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 300)) &&
             (!('profession' in data) || data.profession == null || (data.profession is string && data.profession.size() <= 80)) &&
             (!('isProfessionalVerified' in data) || data.isProfessionalVerified is bool) &&
             (!('professionalOrg' in data) || data.professionalOrg == null || (data.professionalOrg is string && data.professionalOrg.size() <= 100)) &&
             (!('openToNetworking' in data) || data.openToNetworking is bool) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 2000)) &&
             (!('isVerified' in data) || data.isVerified is bool) &&
             (!('verifiedTier' in data) || (data.verifiedTier is string && isValidTier(data.verifiedTier))) &&
             (!('equippedFrame' in data) || data.equippedFrame == null || (data.equippedFrame is string && data.equippedFrame.size() <= 64)) &&
             (!('equippedNameplate' in data) || data.equippedNameplate == null || (data.equippedNameplate is string && data.equippedNameplate.size() <= 64)) &&
             (!('quietMode' in data) || data.quietMode is bool) &&
             (!('readReceiptsEnabled' in data) || data.readReceiptsEnabled is bool) &&
             (!('lastSeen' in data) || data.lastSeen == null || (data.lastSeen is timestamp && data.lastSeen <= request.time)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             !('id' in data) &&
             !('email' in data) &&
             !('phone' in data) &&
             !('role' in data) &&
             !('isAdmin' in data);
    }

    function isValidConversation(data) {
      return (data.type == 'direct' || data.type == 'group') &&
             (!('title' in data) || data.title == null || (data.title is string && data.title.size() <= 100)) &&
             (!('isVerified' in data) || data.isVerified is bool) &&
             (!('verifiedTier' in data) || (data.verifiedTier is string && isValidTier(data.verifiedTier))) &&
             isValidStringList(data.participantIds, 50) && data.participantIds.size() >= 1 &&
             (!('lastMessageText' in data) || data.lastMessageText == null || (data.lastMessageText is string && data.lastMessageText.size() <= 2000)) &&
             (!('lastMessageSenderId' in data) || data.lastMessageSenderId == null || (data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128)) &&
             (!('lastMessageTimestamp' in data) || data.lastMessageTimestamp == null || (data.lastMessageTimestamp is timestamp && data.lastMessageTimestamp <= request.time)) &&
             (!('pinnedBy' in data) || isValidStringList(data.pinnedBy, 50)) &&
             (!('archivedBy' in data) || isValidStringList(data.archivedBy, 50)) &&
             (!('mutedBy' in data) || isValidStringList(data.mutedBy, 50)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time)) &&
             !('id' in data);
    }

    function isValidMessage(data) {
      return data.conversationId is string && isValidId(data.conversationId) &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100 &&
             (!('isSenderVerified' in data) || data.isSenderVerified is bool) &&
             (!('senderVerifiedTier' in data) || (data.senderVerifiedTier is string && isValidTier(data.senderVerifiedTier))) &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 4000 &&
             (!('mediaType' in data) || data.mediaType in ['text', 'image', 'video', 'file']) &&
             (!('mediaId' in data) || data.mediaId == null || (data.mediaId is string && isValidId(data.mediaId))) &&
             (!('mediaFileName' in data) || data.mediaFileName == null || (data.mediaFileName is string && data.mediaFileName.size() <= 255)) &&
             (!('mediaMimeType' in data) || data.mediaMimeType == null || (data.mediaMimeType is string && data.mediaMimeType.size() <= 128)) &&
             (!('mediaSizeBytes' in data) || (data.mediaSizeBytes is int && data.mediaSizeBytes >= 0 && data.mediaSizeBytes <= 26214400)) &&
             (!('mediaChunkCount' in data) || (data.mediaChunkCount is int && data.mediaChunkCount >= 0 && data.mediaChunkCount <= 100)) &&
             (!('mediaDurationMs' in data) || (data.mediaDurationMs is int && data.mediaDurationMs >= 0)) &&
             (!('replyToId' in data) || data.replyToId == null || (data.replyToId is string && data.replyToId.size() <= 128)) &&
             (!('replyToSender' in data) || data.replyToSender == null || (data.replyToSender is string && data.replyToSender.size() <= 100)) &&
             (!('replyToText' in data) || data.replyToText == null || (data.replyToText is string && data.replyToText.size() <= 500)) &&
             (!('status' in data) || data.status in ['sent', 'delivered', 'read']) &&
             (!('readBy' in data) || isValidStringList(data.readBy, 50)) &&
             (!('isEdited' in data) || data.isEdited is bool) &&
             (!('isDeleted' in data) || data.isDeleted is bool) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time)) &&
             !('id' in data);
    }

    function isValidPost(data) {
      return data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
             data.authorHandle is string && data.authorHandle.size() >= 1 && data.authorHandle.size() <= 50 &&
             (!('isAuthorVerified' in data) || data.isAuthorVerified is bool) &&
             (!('authorVerifiedTier' in data) || (data.authorVerifiedTier is string && isValidTier(data.authorVerifiedTier))) &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 5000 &&
             (data.audience == 'public' || data.audience == 'circles') &&
             (!('likedBy' in data) || isValidStringList(data.likedBy, 200)) &&
             (!('likesCount' in data) || (data.likesCount is int && data.likesCount >= 0)) &&
             (!('commentsCount' in data) || (data.commentsCount is int && data.commentsCount >= 0)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time)) &&
             !('id' in data);
    }

    function isValidPostComment(data) {
      return data.postId is string && isValidId(data.postId) &&
             data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
             (!('authorHandle' in data) || data.authorHandle == null || (data.authorHandle is string && data.authorHandle.size() <= 50)) &&
             (!('isAuthorVerified' in data) || data.isAuthorVerified is bool) &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             !('id' in data);
    }

    function isValidSavedMemory(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.originalMessageId is string && data.originalMessageId.size() >= 1 && data.originalMessageId.size() <= 128 &&
             (!('conversationId' in data) || data.conversationId == null || (data.conversationId is string && data.conversationId.size() <= 128)) &&
             data.snippet is string && data.snippet.size() >= 1 && data.snippet.size() <= 1000 &&
             (!('senderName' in data) || data.senderName == null || (data.senderName is string && data.senderName.size() <= 100)) &&
             (!('privateNote' in data) || data.privateNote == null || (data.privateNote is string && data.privateNote.size() <= 2000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             !('id' in data);
    }

    function isValidFluxVideo(data) {
      return data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
             data.authorHandle is string && data.authorHandle.size() >= 1 && data.authorHandle.size() <= 50 &&
             (!('isAuthorVerified' in data) || data.isAuthorVerified is bool) &&
             (!('authorVerifiedTier' in data) || (data.authorVerifiedTier is string && isValidTier(data.authorVerifiedTier))) &&
             data.caption is string && data.caption.size() >= 1 && data.caption.size() <= 2000 &&
             (!('videoUri' in data) || data.videoUri == null || (data.videoUri is string && data.videoUri.size() <= 1000)) &&
             (!('audioTitle' in data) || data.audioTitle == null || (data.audioTitle is string && data.audioTitle.size() <= 120)) &&
             (!('likesCount' in data) || (data.likesCount is int && data.likesCount >= 0)) &&
             (!('likedBy' in data) || isValidStringList(data.likedBy, 200)) &&
             (!('commentsCount' in data) || (data.commentsCount is int && data.commentsCount >= 0)) &&
             (!('sharesCount' in data) || (data.sharesCount is int && data.sharesCount >= 0)) &&
             (!('savedBy' in data) || isValidStringList(data.savedBy, 200)) &&
             (!('tags' in data) || isValidStringList(data.tags, 15)) &&
             (!('gradientTheme' in data) || data.gradientTheme in ['BLURPLE', 'NITRO', 'EMERALD', 'SOLAR', 'CYBER']) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             !('id' in data);
    }

    function isValidFluxComment(data) {
      return data.fluxId is string && isValidId(data.fluxId) &&
             data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
             (!('authorHandle' in data) || data.authorHandle == null || (data.authorHandle is string && data.authorHandle.size() <= 50)) &&
             (!('isAuthorVerified' in data) || data.isAuthorVerified is bool) &&
             (!('authorVerifiedTier' in data) || (data.authorVerifiedTier is string && isValidTier(data.authorVerifiedTier))) &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             !('id' in data);
    }

    // User Directory Profiles (Zero-PII)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       (!('isProfessionalVerified' in incoming()) || incoming().isProfessionalVerified == false) &&
                       incoming().keys().hasAll(['displayName', 'handle', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'displayName', 'handle', 'bio', 'profession', 'isProfessionalVerified',
                         'professionalOrg', 'openToNetworking', 'avatarUrl', 'isVerified',
                         'verifiedTier', 'equippedFrame', 'equippedNameplate', 'quietMode',
                         'readReceiptsEnabled', 'lastSeen', 'createdAt', 'updatedAt'
                       ]);

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       (!('isProfessionalVerified' in incoming()) ||
                        incoming().isProfessionalVerified == existing().get('isProfessionalVerified', false)) &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['lastSeen']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'handle', 'bio', 'profession', 'professionalOrg',
                           'openToNetworking', 'avatarUrl', 'isVerified', 'verifiedTier',
                           'equippedFrame', 'equippedNameplate', 'quietMode',
                           'readReceiptsEnabled', 'lastSeen', 'updatedAt'
                         ])
                       );

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      // Server-Authoritative Store Wallet & Owned Decorations
      match /wallet/{walletId} {
        function framePriceMap() {
          return {
            'cat_bell': 200,
            'violet_night': 200,
            'skull_eye': 200,
            'octopus_crown': 200,
            'future_mech': 200,
            'sakura_tide': 50,
            'celestial_wings': 500,
            'imperial_gold': 400,
            'dragon_flame': 450,
            'cosmic_swirl': 300
          };
        }

        function nameplatePriceMap() {
          return {
            'np_aurora': 100,
            'np_prismatic': 100,
            'np_golden': 100,
            'np_midnight': 100,
            'np_moonlit': 300,
            'np_bone_noir': 350
          };
        }

        function isValidStoreWallet(data) {
          return data.coinBalance is int &&
                 data.coinBalance >= 0 &&
                 data.coinBalance <= 100000 &&
                 isValidStringList(data.ownedItemIds, 100) &&
                 isValidStringList(data.claimedMilestones, 20) &&
                 (!('lastDailyClaimAt' in data) || data.lastDailyClaimAt == null || (data.lastDailyClaimAt is timestamp && data.lastDailyClaimAt <= request.time)) &&
                 (!('equippedFrame' in data) || data.equippedFrame == null || (data.equippedFrame is string && data.equippedFrame.size() <= 64)) &&
                 (!('equippedNameplate' in data) || data.equippedNameplate == null || (data.equippedNameplate is string && data.equippedNameplate.size() <= 64)) &&
                 data.createdAt is timestamp && data.createdAt <= request.time &&
                 data.updatedAt is timestamp && data.updatedAt <= request.time &&
                 !('id' in data);
        }

        allow get: if isSignedIn() && request.auth.uid == userId && walletId == 'state';
        allow list, delete: if false;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         walletId == 'state' &&
                         isValidStoreWallet(incoming()) &&
                         incoming().keys().hasAll(['coinBalance', 'ownedItemIds', 'claimedMilestones', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly([
                           'coinBalance', 'ownedItemIds', 'claimedMilestones',
                           'lastDailyClaimAt', 'equippedFrame', 'equippedNameplate',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().coinBalance == 500 &&
                         incoming().ownedItemIds.size() == 0 &&
                         incoming().claimedMilestones.size() == 0 &&
                         (!('lastDailyClaimAt' in incoming()) || incoming().lastDailyClaimAt == null) &&
                         (!('equippedFrame' in incoming()) || incoming().equippedFrame == null) &&
                         (!('equippedNameplate' in incoming()) || incoming().equippedNameplate == null);

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         walletId == 'state' &&
                         isValidStoreWallet(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           // 1. Daily check-in (+250 coins, 24h cooldown verified against server request.time)
                           (
                             incoming().diff(existing()).affectedKeys().hasOnly(['coinBalance', 'lastDailyClaimAt', 'updatedAt']) &&
                             incoming().coinBalance == existing().coinBalance + 250 &&
                             incoming().lastDailyClaimAt == request.time &&
                             (!('lastDailyClaimAt' in existing()) ||
                              existing().lastDailyClaimAt == null ||
                              existing().lastDailyClaimAt + duration.value(24, 'h') <= request.time)
                           ) ||
                           // 2. One-time milestone quest rewards
                           (
                             incoming().diff(existing()).affectedKeys().hasOnly(['coinBalance', 'claimedMilestones', 'updatedAt']) &&
                             incoming().claimedMilestones.size() == existing().claimedMilestones.size() + 1 &&
                             incoming().claimedMilestones.hasAll(existing().claimedMilestones) &&
                             (
                               ('m_profile' in incoming().claimedMilestones && !('m_profile' in existing().claimedMilestones) && incoming().coinBalance == existing().coinBalance + 150) ||
                               ('m_verified' in incoming().claimedMilestones && !('m_verified' in existing().claimedMilestones) && incoming().coinBalance == existing().coinBalance + 200) ||
                               ('m_flux' in incoming().claimedMilestones && !('m_flux' in existing().claimedMilestones) && incoming().coinBalance == existing().coinBalance + 250) ||
                               ('m_avatar' in incoming().claimedMilestones && !('m_avatar' in existing().claimedMilestones) && incoming().coinBalance == existing().coinBalance + 150)
                             )
                           ) ||
                           // 3a. Buy Avatar Frame (exact price deducted & auto-equipped)
                           (
                             incoming().diff(existing()).affectedKeys().hasOnly(['coinBalance', 'ownedItemIds', 'equippedFrame', 'updatedAt']) &&
                             incoming().equippedFrame is string &&
                             incoming().equippedFrame in framePriceMap() &&
                             !(incoming().equippedFrame in existing().ownedItemIds) &&
                             incoming().equippedFrame in incoming().ownedItemIds &&
                             incoming().ownedItemIds.size() == existing().ownedItemIds.size() + 1 &&
                             incoming().ownedItemIds.hasAll(existing().ownedItemIds) &&
                             incoming().coinBalance == existing().coinBalance - framePriceMap()[incoming().equippedFrame]
                           ) ||
                           // 3b. Buy Role Nameplate (exact price deducted & auto-equipped)
                           (
                             incoming().diff(existing()).affectedKeys().hasOnly(['coinBalance', 'ownedItemIds', 'equippedNameplate', 'updatedAt']) &&
                             incoming().equippedNameplate is string &&
                             incoming().equippedNameplate in nameplatePriceMap() &&
                             !(incoming().equippedNameplate in existing().ownedItemIds) &&
                             incoming().equippedNameplate in incoming().ownedItemIds &&
                             incoming().ownedItemIds.size() == existing().ownedItemIds.size() + 1 &&
                             incoming().ownedItemIds.hasAll(existing().ownedItemIds) &&
                             incoming().coinBalance == existing().coinBalance - nameplatePriceMap()[incoming().equippedNameplate]
                           ) ||
                           // 4. Equip / unequip owned decorations only
                           (
                             incoming().diff(existing()).affectedKeys().hasOnly(['equippedFrame', 'equippedNameplate', 'updatedAt']) &&
                             (!('equippedFrame' in incoming()) || incoming().equippedFrame == null || incoming().equippedFrame in existing().ownedItemIds) &&
                             (!('equippedNameplate' in incoming()) || incoming().equippedNameplate == null || incoming().equippedNameplate in existing().ownedItemIds)
                           )
                         );
      }

      // Saved Memories subcollection (Strictly private per-user vault)
      match /saved_memories/{memoryId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(memoryId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(memoryId) &&
                         request.auth.uid == userId &&
                         isValidSavedMemory(incoming()) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'originalMessageId', 'snippet', 'createdAt']) &&
                         incoming().keys().hasOnly([
                           'userId', 'originalMessageId', 'conversationId', 'snippet',
                           'senderName', 'privateNote', 'createdAt'
                         ]);

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(memoryId) &&
                         request.auth.uid == userId &&
                         isValidSavedMemory(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['privateNote']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(memoryId) && request.auth.uid == userId;
      }
    }

    // Conversations (Strict Participant Isolation)
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && request.auth.uid in existing().participantIds;
      allow list: if isSignedIn() && request.auth.uid in existing().participantIds;

      allow create: if isSignedIn() &&
                       isValidId(conversationId) &&
                       isValidConversation(incoming()) &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().keys().hasAll(['type', 'participantIds', 'createdAt']) &&
                       incoming().keys().hasOnly([
                         'type', 'title', 'isVerified', 'verifiedTier', 'participantIds',
                         'lastMessageText', 'lastMessageSenderId', 'lastMessageTimestamp',
                         'pinnedBy', 'archivedBy', 'mutedBy', 'createdAt', 'updatedAt'
                       ]);

      allow update: if isSignedIn() &&
                       isValidId(conversationId) &&
                       isValidConversation(incoming()) &&
                       request.auth.uid in existing().participantIds &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().type == existing().type &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'lastMessageText', 'lastMessageSenderId', 'lastMessageTimestamp', 'updatedAt'
                         ]) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'pinnedBy', 'archivedBy', 'mutedBy', 'updatedAt'
                         ]) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'updatedAt'
                         ])
                       );

      allow delete: if false;

      // Messages inside a conversation (Parent-Gated)
      match /messages/{messageId} {
        allow get: if isValidId(conversationId) && isValidId(messageId) && isConvoParticipant(conversationId);
        allow list: if isValidId(conversationId) && isConvoParticipant(conversationId);

        allow create: if isSignedIn() &&
                         isValidId(conversationId) &&
                         isValidId(messageId) &&
                         isValidMessage(incoming()) &&
                         incoming().senderId == request.auth.uid &&
                         incoming().conversationId == conversationId &&
                         (!('isEdited' in incoming()) || incoming().isEdited == false) &&
                         (!('isDeleted' in incoming()) || incoming().isDeleted == false) &&
                         incoming().keys().hasAll(['conversationId', 'senderId', 'senderName', 'content', 'createdAt']) &&
                         incoming().keys().hasOnly([
                           'conversationId', 'senderId', 'senderName', 'isSenderVerified', 'senderVerifiedTier',
                           'content', 'mediaType', 'mediaId', 'mediaFileName', 'mediaMimeType',
                           'mediaSizeBytes', 'mediaChunkCount', 'mediaDurationMs',
                           'replyToId', 'replyToSender', 'replyToText', 'status', 'readBy',
                           'isEdited', 'isDeleted', 'createdAt', 'updatedAt'
                         ]) &&
                         isConvoParticipant(conversationId);

        allow update: if isSignedIn() &&
                         isValidId(conversationId) &&
                         isValidId(messageId) &&
                         isValidMessage(incoming()) &&
                         incoming().senderId == existing().senderId &&
                         incoming().conversationId == existing().conversationId &&
                         incoming().createdAt == existing().createdAt &&
                         isConvoParticipant(conversationId) &&
                         (
                           (existing().senderId == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['content', 'isEdited', 'isDeleted', 'updatedAt'])) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'readBy', 'updatedAt'])
                         );

        allow delete: if false;
      }

      // Chunked high-quality media payloads inside a conversation (Parent-Gated)
      match /media/{mediaId}/chunks/{chunkId} {
        allow get, list: if isValidId(conversationId) && isValidId(mediaId) && isConvoParticipant(conversationId);

        allow create: if isSignedIn() &&
                         isValidId(conversationId) &&
                         isValidId(mediaId) &&
                         isValidId(chunkId) &&
                         isConvoParticipant(conversationId) &&
                         incoming().senderId == request.auth.uid &&
                         incoming().mediaId == mediaId &&
                         incoming().index is int && incoming().index >= 0 && incoming().index < 100 &&
                         incoming().data is string && incoming().data.size() >= 1 && incoming().data.size() <= 750000 &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().keys().hasAll(['mediaId', 'senderId', 'index', 'data', 'createdAt']) &&
                         incoming().keys().hasOnly(['mediaId', 'senderId', 'index', 'data', 'createdAt']);

        allow update, delete: if false;
      }
    }

    // Social Feed Posts
    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidPost(incoming()) &&
                       incoming().authorId == request.auth.uid &&
                       (!('likesCount' in incoming()) || incoming().likesCount == 0) &&
                       (!('commentsCount' in incoming()) || incoming().commentsCount == 0) &&
                       (!('likedBy' in incoming()) || incoming().likedBy.size() == 0) &&
                       incoming().keys().hasAll(['authorId', 'authorName', 'authorHandle', 'content', 'audience', 'createdAt']) &&
                       incoming().keys().hasOnly([
                         'authorId', 'authorName', 'authorHandle', 'isAuthorVerified', 'authorVerifiedTier',
                         'content', 'audience', 'likedBy', 'likesCount', 'commentsCount', 'createdAt', 'updatedAt'
                       ]);

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidPost(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (existing().authorId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['content', 'audience', 'updatedAt'])) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['likedBy', 'likesCount']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount'])
                       );

      allow delete: if isSignedIn() && isValidId(postId) && existing().authorId == request.auth.uid;

      // Post Comments / Context Threads
      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(commentId);
        allow list: if isSignedIn() && isValidId(postId);

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         isValidPostComment(incoming()) &&
                         incoming().authorId == request.auth.uid &&
                         incoming().postId == postId &&
                         incoming().keys().hasAll(['postId', 'authorId', 'authorName', 'content', 'createdAt']) &&
                         incoming().keys().hasOnly([
                           'postId', 'authorId', 'authorName', 'authorHandle', 'isAuthorVerified',
                           'content', 'createdAt'
                         ]) &&
                         exists(/databases/$(database)/documents/posts/$(postId));

        allow update: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         isValidPostComment(incoming()) &&
                         existing().authorId == request.auth.uid &&
                         incoming().authorId == existing().authorId &&
                         incoming().postId == existing().postId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['content']);

        allow delete: if isSignedIn() && isValidId(postId) && isValidId(commentId) && existing().authorId == request.auth.uid;
      }
    }

    // Flux Short Videos
    match /flux_videos/{fluxId} {
      allow get: if isSignedIn() && isValidId(fluxId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(fluxId) &&
                       isValidFluxVideo(incoming()) &&
                       incoming().authorId == request.auth.uid &&
                       (!('likesCount' in incoming()) || incoming().likesCount == 0) &&
                       (!('commentsCount' in incoming()) || incoming().commentsCount == 0) &&
                       (!('sharesCount' in incoming()) || incoming().sharesCount == 0) &&
                       incoming().keys().hasAll(['authorId', 'authorName', 'authorHandle', 'caption', 'createdAt']) &&
                       incoming().keys().hasOnly([
                         'authorId', 'authorName', 'authorHandle', 'isAuthorVerified', 'authorVerifiedTier',
                         'caption', 'videoUri', 'audioTitle', 'likesCount', 'likedBy', 'commentsCount',
                         'sharesCount', 'savedBy', 'tags', 'gradientTheme', 'createdAt'
                       ]);

      allow update: if isSignedIn() &&
                       isValidId(fluxId) &&
                       isValidFluxVideo(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (existing().authorId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'audioTitle'])) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['likedBy', 'likesCount']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['savedBy']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['sharesCount']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount'])
                       );

      allow delete: if isSignedIn() && isValidId(fluxId) && existing().authorId == request.auth.uid;

      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(fluxId) && isValidId(commentId);
        allow list: if isSignedIn() && isValidId(fluxId);

        allow create: if isSignedIn() &&
                         isValidId(fluxId) &&
                         isValidId(commentId) &&
                         isValidFluxComment(incoming()) &&
                         incoming().authorId == request.auth.uid &&
                         incoming().fluxId == fluxId &&
                         incoming().keys().hasAll(['fluxId', 'authorId', 'authorName', 'content', 'createdAt']) &&
                         incoming().keys().hasOnly([
                           'fluxId', 'authorId', 'authorName', 'authorHandle', 'isAuthorVerified',
                           'authorVerifiedTier', 'content', 'createdAt'
                         ]) &&
                         exists(/databases/$(database)/documents/flux_videos/$(fluxId));

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(fluxId) && isValidId(commentId) && existing().authorId == request.auth.uid;
      }
    }

    // Two-Party Voice Calls & WebRTC Signaling (Strict Participant Isolation)
    match /calls/{callId} {
      function isCallParticipant(cid) {
        return isSignedIn() &&
               exists(/databases/$(database)/documents/calls/$(cid)) &&
               request.auth.uid in get(/databases/$(database)/documents/calls/$(cid)).data.participantIds;
      }

      function isValidVoiceCall(data) {
        return data.conversationId is string && isValidId(data.conversationId) &&
               data.callerId is string && data.callerId.size() >= 1 && data.callerId.size() <= 128 &&
               data.callerName is string && data.callerName.size() >= 1 && data.callerName.size() <= 100 &&
               (!('callerAvatarUrl' in data) || data.callerAvatarUrl == null || (data.callerAvatarUrl is string && data.callerAvatarUrl.size() <= 2000)) &&
               data.calleeId is string && data.calleeId.size() >= 1 && data.calleeId.size() <= 128 &&
               (!('calleeName' in data) || data.calleeName == null || (data.calleeName is string && data.calleeName.size() <= 100)) &&
               (!('calleeAvatarUrl' in data) || data.calleeAvatarUrl == null || (data.calleeAvatarUrl is string && data.calleeAvatarUrl.size() <= 2000)) &&
               isValidStringList(data.participantIds, 2) && data.participantIds.size() == 2 &&
               data.callerId in data.participantIds &&
               data.calleeId in data.participantIds &&
               data.status in ['ringing', 'connecting', 'connected', 'ended', 'declined', 'missed'] &&
               (!('offerSdp' in data) || data.offerSdp == null || (data.offerSdp is string && data.offerSdp.size() <= 40000)) &&
               (!('answerSdp' in data) || data.answerSdp == null || (data.answerSdp is string && data.answerSdp.size() <= 40000)) &&
               data.createdAt is timestamp && data.createdAt <= request.time &&
               data.updatedAt is timestamp && data.updatedAt <= request.time &&
               (!('endedAt' in data) || data.endedAt == null || (data.endedAt is timestamp && data.endedAt <= request.time)) &&
               !('id' in data);
      }

      allow get: if isSignedIn() && isValidId(callId) && request.auth.uid in existing().participantIds;
      allow list: if isSignedIn() && request.auth.uid in existing().participantIds;

      allow create: if isSignedIn() &&
                       isValidId(callId) &&
                       isValidVoiceCall(incoming()) &&
                       incoming().callerId == request.auth.uid &&
                       incoming().status == 'ringing' &&
                       incoming().keys().hasAll([
                         'conversationId', 'callerId', 'callerName', 'calleeId',
                         'participantIds', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'conversationId', 'callerId', 'callerName', 'callerAvatarUrl',
                         'calleeId', 'calleeName', 'calleeAvatarUrl', 'participantIds',
                         'status', 'offerSdp', 'answerSdp', 'createdAt', 'updatedAt', 'endedAt'
                       ]);

      allow update: if isSignedIn() &&
                       isValidId(callId) &&
                       isValidVoiceCall(incoming()) &&
                       request.auth.uid in existing().participantIds &&
                       request.auth.uid in incoming().participantIds &&
                       incoming().callerId == existing().callerId &&
                       incoming().calleeId == existing().calleeId &&
                       incoming().participantIds == existing().participantIds &&
                       incoming().conversationId == existing().conversationId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'offerSdp', 'answerSdp', 'updatedAt', 'endedAt'
                       ]);

      allow delete: if false;

      match /candidates/{candidateId} {
        allow get, list: if isValidId(callId) && isCallParticipant(callId);

        allow create: if isSignedIn() &&
                         isValidId(callId) &&
                         isValidId(candidateId) &&
                         isCallParticipant(callId) &&
                         incoming().senderId == request.auth.uid &&
                         incoming().sdpMid is string && incoming().sdpMid.size() <= 64 &&
                         incoming().sdpMLineIndex is int && incoming().sdpMLineIndex >= 0 &&
                         incoming().candidate is string && incoming().candidate.size() >= 1 && incoming().candidate.size() <= 4096 &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().keys().hasAll(['senderId', 'sdpMid', 'sdpMLineIndex', 'candidate', 'createdAt']) &&
                         incoming().keys().hasOnly(['senderId', 'sdpMid', 'sdpMLineIndex', 'candidate', 'createdAt']);

        allow update, delete: if false;
      }
    }
  }
}
